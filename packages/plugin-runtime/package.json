{
  "name": "@shieldscan/plugin-runtime",
  "version": "0.1.0",
  "description": "插件化核心平台：Kernel、Event Bus、插件生命週期與沙箱介面",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shieldscan/core-schema": "workspace:*"
  }
}
