{
  "name": "@shieldscan/node-sdk",
  "version": "0.1.0",
  "description": "Node.js 後端驗證 SDK：HTTP headers、TLS/JA4 指紋、IP 環境",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shieldscan/core-schema": "workspace:*"
  }
}
