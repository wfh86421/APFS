{
  "name": "@shieldscan/browser-sdk",
  "version": "0.1.0",
  "description": "瀏覽器端指紋與環境採集 SDK（framework-agnostic）",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shieldscan/core-schema": "workspace:*"
  }
}
