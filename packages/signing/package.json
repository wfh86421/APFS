{
  "name": "@shieldscan/signing",
  "version": "0.1.0",
  "description": "報告正式簽章：HMAC-SHA256 簽名與完整性驗證（Web Crypto，瀏覽器/Node 通用）",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/*.test.js\"",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@shieldscan/core-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
