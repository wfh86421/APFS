{
  "name": "@shieldscan/policy-engine",
  "version": "0.1.0",
  "description": "政策引擎：把評分轉成 allow / review / challenge / block 決策",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shieldscan/core-schema": "workspace:*"
  }
}
