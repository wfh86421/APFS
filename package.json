{
  "name": "shieldscan",
  "version": "0.1.0",
  "private": true,
  "description": "ShieldScan（隱盾檢測）— 跨端環境可信度基礎設施",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @shieldscan/web-scanner dev",
    "dev:api": "pnpm --filter @shieldscan/api dev"
  }
}
